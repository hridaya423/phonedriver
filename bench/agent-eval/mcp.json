{
  "mcpServers": {
    "phonedriver": {
      "command": "${PHONEDRIVER_BIN}",
      "args": ["mcp"],
      "env": {
        "PHONEDRIVER_HOME": "${PHONEDRIVER_HOME}",
        "PHONEDRIVER_DEVICE": "${PHONEDRIVER_DEVICE}",
        "PHONEDRIVER_TRACE_FULL": "1",
        "ADB_SERVER_SOCKET": "${ADB_SERVER_SOCKET}"
      }
    }
  }
}
